# The service reads these from its environment; nothing loads a .env file by
# itself. Set them in the systemd unit (Environment= or EnvironmentFile=) or
# export them before starting the development server.

# Printer address, optionally with a port. Leave empty to run preview only:
# the interface stays fully usable and the print button stays off.
# RECEIPT_PRINTER=192.0.2.50
# RECEIPT_PRINTER=192.0.2.50:9101

# Where history.jsonl, jobs.json, audit.jsonl and roll.json are kept. When
# unset: /var/lib/thermal-receipt-webui if writable, otherwise
# ~/.local/state/thermal-receipt-webui.
# RECEIPT_STATE_DIR=/var/lib/thermal-receipt-webui
