# Copy to .env, or set these in the systemd unit.

# Printer address, optionally with a port. Leave empty to run preview only:
# the interface stays fully usable and the print button stays off.
# RECEIPT_PRINTER=192.0.2.50
# RECEIPT_PRINTER=192.0.2.50:9101

# Where the print history is kept. Defaults to
# ~/.local/state/thermal-receipt-webui when unset.
# RECEIPT_STATE_DIR=/var/lib/thermal-receipt-webui
